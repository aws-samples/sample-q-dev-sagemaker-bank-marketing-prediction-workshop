# Paste the values from your workshop's Event outputs (or CloudFormation -> Outputs).
# The placeholders on the right of each `=` show the matching CFN output name.

AWS_ACCESS_KEY_ID=<AwsAccessKeyId>
AWS_SECRET_ACCESS_KEY=<AwsSecretAccessKey>
SAGEMAKER_EXECUTION_ROLE=<SagemakerExecutionRoleArn>
S3_BUCKET_NAME=<WorkshopBucketName>

# AWS region the workshop is deployed in (us-east-1 by default).
AWS_REGION=us-east-1
